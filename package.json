{
  "name": "jarvis-local",
  "version": "0.1.0",
  "private": true,
  "description": "Jarvis Local AI Agent - Autonomous personal assistant on ASUS ROG Flow Z13",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "tsx --test tests/**/*.test.ts",
    "devagent": "tsx src/devagent/cli.ts",
    "devagent:watch": "tsx src/devagent/cli.ts --watch",
    "research": "tsx src/cli/research.ts",
    "web": "tsx src/cli/web.ts",
    "telegram": "tsx src/cli/telegram.ts",
    "preflight": "powershell -ExecutionPolicy Bypass -File scripts/preflight.ps1",
    "benchmark": "powershell -ExecutionPolicy Bypass -File scripts/benchmark.ps1"
  },
  "dependencies": {
    "dotenv": "18.0.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
